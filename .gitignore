node_modules/
dist/

# Copias de seguridad (ISSUE-015). Un dump del piloto contiene datos de
# clientes, ventas y hashes de contraseña: no entra en Git bajo ningún nombre.
ops/backups/
*.dump
*.dump.parcial
*.dump.sha256
*.sql.gz

# Salidas del E2E (Playwright): trazas, capturas e informes se generan en cada
# ejecución y solo se publican como artefacto de CI cuando el job falla.
test-results/
playwright-report/
blob-report/
/playwright/.cache/
