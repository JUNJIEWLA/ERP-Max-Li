# Copiar a application-dev.yml y completar con valores locales.
# NUNCA commitear application-dev.yml (está en .gitignore).
#
# Los valores de JWT y CORS para desarrollo ya vienen en el documento `dev`
# de application.yml; aquí solo hace falta la conexión a la base local.
#
# SI YA TIENE UN application-dev.yml DE ANTES: borre de él los bloques `jwt:`
# y `cors:`. Un application-dev.yml gana sobre application.yml, así que esos
# bloques antiguos siguen fijando la expiración en 24 h y anulan el valor de
# 8 h que trae ahora el proyecto.
spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/maxli_db}
    username: ${DB_USER:postgres}
    password: ${DB_PASSWORD:}
    driver-class-name: org.postgresql.Driver
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true

maxli:
  security:
    bootstrap:
      # Contraseña de la cuenta admin en la primera instalación local.
      # La migración V35 deja esa cuenta bloqueada; sin este valor nadie puede
      # entrar. Se consume una sola vez y obliga a cambiarla al primer ingreso.
      admin-password: ${BOOTSTRAP_ADMIN_PASSWORD:}
